---
layout: base.njk
title: Membership
permalink: /membership/
---

{% block head_schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "DRUM Task Group Membership and Meetings",
  "description": "Directory of the CODATA Digital Representation of Units of Measurement (DRUM) Task Group chairs, secretaries, active members, and past members, along with the rotating global meeting schedule.",
  "mainEntity": {
    "@type": "Committee",
    "name": "CODATA DRUM Task Group",
    "member": [
      {% set allMembers = [] %}
      {% for person in members.chairs %}
        {% set dummy = allMembers.push({"name": person.name, "role": "Chair", "org": person.affiliation, "country": person.country}) %}
      {% endfor %}
      {% for person in members.secretaries %}
        {% set dummy = allMembers.push({"name": person.name, "role": "Secretary", "org": person.affiliation, "country": person.country}) %}
      {% endfor %}
      {% for person in members.members %}
        {% set dummy = allMembers.push({"name": person.name, "role": "Member", "org": person.affiliation, "country": person.country}) %}
      {% endfor %}
      {% for person in members.past %}
        {% set dummy = allMembers.push({"name": person.name, "role": "Past Member", "org": person.affiliation, "country": person.country}) %}
      {% endfor %}
      {% for item in allMembers %}
      {
        "@type": "OrganizationRole",
        "roleName": "{{ item.role }}",
        "member": {
          "@type": "Person",
          "name": "{{ item.name | escape }}",
          {% if item.org or item.country %}
          "worksFor": {
            "@type": "Organization",
            "name": "{{ item.org | default('Independent') | escape }}"{% if item.country %},
            "address": {
              "@type": "PostalAddress",
              "addressCountry": "{{ item.country | escape }}"
            }{% endif %}
          }
          {% endif %}
        }
      }{{ "," if not loop.last }}
      {% endfor %}
    ]
  }
}
</script>
{% endblock %}

<div class="py-16" x-data="meetingPlanner()">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-10 items-center">
            <div class="lg:col-span-8">
                <h1 class="text-4xl font-bold tracking-tight text-theme-text sm:text-5xl mb-6">{{ site.pages.members.title }}</h1>
                <p class="text-xl text-theme-muted leading-relaxed">
                    {{ site.pages.members.lead }}
                </p>
                
                <div class="mt-6 flex flex-wrap gap-6 text-sm text-theme-muted">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-theme-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Meeting Rhythm: every couple of weeks, rotating across regional time zones.</span>
                    </div>
                </div>
            </div>
            
            <div class="lg:col-span-4">
                <div class="p-6 bg-theme-surface rounded-xl border border-theme-accent/20 shadow-sm relative overflow-hidden group">
                    <div class="absolute -right-4 -top-4 w-24 h-24 bg-theme-accent/5 rounded-full blur-2xl group-hover:bg-theme-accent/10 transition-colors"></div>
                    
                    <h2 class="text-xl font-bold text-theme-text mb-3 relative z-10">{{ site.pages.members.join.title }}</h2>
                    <p class="text-sm text-theme-muted mb-6 relative z-10">{{ site.pages.members.join.description }}</p>
                    
                    <div class="flex flex-col gap-3 relative z-10">
                        <a href="{{ site.pages.members.join.formUrl }}" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center px-6 py-2.5 text-sm font-bold rounded-[var(--radius-theme)] text-theme-accent-fg bg-theme-accent hover:bg-theme-accent/90 transition-all shadow-md hover:-translate-y-0.5">
                            {{ site.pages.members.join.cta }}
                            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </a>
                        
                        <a href="{{ site.pages.members.join.email }}" class="w-full inline-flex items-center justify-center px-6 py-2.5 text-sm font-semibold rounded-[var(--radius-theme)] text-theme-text bg-theme-surface hover:bg-theme-surface/85 border border-theme-text/10 transition-all">
                            Contact: drum@codata.org
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Task Group Roles Navigation -->
        <nav class="sticky top-[80px] z-30 mb-10 py-4 bg-theme-bg/95 backdrop-blur-xl -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
            <div class="flex flex-wrap items-center gap-3">
                <a href="#meetings" class="inline-flex items-center px-4 py-2 rounded-full bg-theme-surface border border-theme-text/10 text-xs font-bold text-theme-text/70 hover:bg-theme-accent hover:text-white hover:border-theme-accent hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
                    Upcoming Meetings
                </a>
                <a href="#leadership" class="inline-flex items-center px-4 py-2 rounded-full bg-theme-surface border border-theme-text/10 text-xs font-bold text-theme-text/70 hover:bg-theme-accent hover:text-white hover:border-theme-accent hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
                    Leadership
                </a>
                <a href="#active-members" class="inline-flex items-center px-4 py-2 rounded-full bg-theme-surface border border-theme-text/10 text-xs font-bold text-theme-text/70 hover:bg-theme-accent hover:text-white hover:border-theme-accent hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
                    Active Members
                </a>
                <a href="#past-members" class="inline-flex items-center px-4 py-2 rounded-full bg-theme-surface border border-theme-text/10 text-xs font-bold text-theme-text/70 hover:bg-theme-accent hover:text-white hover:border-theme-accent hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
                    Past Members
                </a>
            </div>
        </nav>

        <div class="space-y-12">
            <!-- Upcoming Meetings -->
            <section id="meetings" class="border-t border-theme-text/10 pt-10 scroll-mt-32">
                <h2 class="text-2xl font-bold text-theme-text mb-2">Upcoming Meetings</h2>
                <p class="text-sm text-theme-muted mb-8 max-w-2xl">
                    DRUM rotating meetings occur every two weeks to support our global membership base. The upcoming schedules for each timezone group are shown below in both UTC and your local browser time.
                </p>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- EUAWA -->
                    <div class="bg-theme-surface border border-theme-text/5 rounded-xl p-6 hover:border-theme-accent/30 transition-all shadow-sm flex flex-col justify-between">
                        <div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-blue-700 border border-blue-200 dark:bg-blue-500/10 dark:text-blue-400 dark:border-blue-400/20 mb-4">
                                EUAWA Group
                            </span>
                            <h3 class="text-lg font-bold text-theme-text mb-2 animate-pulse-slow">Europe / Africa / West Asia</h3>
                            <template x-if="euawaMeeting">
                                <div class="space-y-3 mt-4">
                                    <div>
                                        <div class="text-[10px] uppercase font-bold text-theme-muted tracking-wider">UTC Time</div>
                                        <div class="text-sm text-theme-text font-semibold" x-text="formatUTC(euawaMeeting.utc)"></div>
                                    </div>
                                    <div>
                                        <div class="text-[10px] uppercase font-bold text-theme-muted tracking-wider">Your Local Time</div>
                                        <div class="text-sm text-theme-accent font-bold" x-text="formatLocal(euawaMeeting.utc)"></div>
                                    </div>
                                </div>
                            </template>
                            <template x-if="!euawaMeeting">
                                <p class="text-sm text-theme-muted italic mt-4">No upcoming meetings scheduled.</p>
                            </template>
                        </div>
                    </div>
                    
                    <!-- AMER -->
                    <div class="bg-theme-surface border border-theme-text/5 rounded-xl p-6 hover:border-theme-accent/30 transition-all shadow-sm flex flex-col justify-between">
                        <div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-purple-100 text-purple-700 border border-purple-200 dark:bg-purple-500/10 dark:text-purple-400 dark:border-purple-400/20 mb-4">
                                AMER Group
                            </span>
                            <h3 class="text-lg font-bold text-theme-text mb-2 animate-pulse-slow">Americas</h3>
                            <template x-if="amerMeeting">
                                <div class="space-y-3 mt-4">
                                    <div>
                                        <div class="text-[10px] uppercase font-bold text-theme-muted tracking-wider">UTC Time</div>
                                        <div class="text-sm text-theme-text font-semibold" x-text="formatUTC(amerMeeting.utc)"></div>
                                    </div>
                                    <div>
                                        <div class="text-[10px] uppercase font-bold text-theme-muted tracking-wider">Your Local Time</div>
                                        <div class="text-sm text-theme-accent font-bold" x-text="formatLocal(amerMeeting.utc)"></div>
                                    </div>
                                </div>
                            </template>
                            <template x-if="!amerMeeting">
                                <p class="text-sm text-theme-muted italic mt-4">No upcoming meetings scheduled.</p>
                            </template>
                        </div>
                    </div>

                    <!-- EAOP -->
                    <div class="bg-theme-surface border border-theme-text/5 rounded-xl p-6 hover:border-theme-accent/30 transition-all shadow-sm flex flex-col justify-between">
                        <div>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-green-100 text-green-700 border border-green-200 dark:bg-green-500/10 dark:text-green-400 dark:border-green-400/20 mb-4">
                                EAOP Group
                            </span>
                            <h3 class="text-lg font-bold text-theme-text mb-2 animate-pulse-slow">East Asia / Oceania / Pacific</h3>
                            <template x-if="eaopMeeting">
                                <div class="space-y-3 mt-4">
                                    <div>
                                        <div class="text-[10px] uppercase font-bold text-theme-muted tracking-wider">UTC Time</div>
                                        <div class="text-sm text-theme-text font-semibold" x-text="formatUTC(eaopMeeting.utc)"></div>
                                    </div>
                                    <div>
                                        <div class="text-[10px] uppercase font-bold text-theme-muted tracking-wider">Your Local Time</div>
                                        <div class="text-sm text-theme-accent font-bold" x-text="formatLocal(eaopMeeting.utc)"></div>
                                    </div>
                                </div>
                            </template>
                            <template x-if="!eaopMeeting">
                                <p class="text-sm text-theme-muted italic mt-4">No upcoming meetings scheduled.</p>
                            </template>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Leadership -->
            <section id="leadership" class="border-t border-theme-text/10 pt-10 scroll-mt-32">
                <h2 class="text-2xl font-bold text-theme-text mb-8">Leadership</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for person in members.chairs %}
                    <div class="bg-theme-surface border border-theme-text/5 rounded-xl p-6 hover:border-theme-accent/30 transition-all shadow-sm">
                        <div class="flex justify-between items-start mb-4 gap-2">
                            <h3 class="text-lg font-bold text-theme-text leading-tight">{{ person.name }}</h3>
                            <span class="flex-shrink-0 px-2 py-0.5 bg-theme-accent/15 text-theme-accent rounded text-[10px] font-bold uppercase tracking-wider">Chair</span>
                        </div>
                        <p class="text-sm text-theme-muted leading-snug">{{ person.affiliation }}</p>
                        {% if person.country %}
                        <div class="text-xs text-theme-muted/70 mt-2.5 flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 opacity-65" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span>{{ person.country }}</span>
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}

                    {% for person in members.secretaries %}
                    <div class="bg-theme-surface border border-theme-text/5 rounded-xl p-6 hover:border-theme-accent/30 transition-all shadow-sm">
                        <div class="flex justify-between items-start mb-4 gap-2">
                            <h3 class="text-lg font-bold text-theme-text leading-tight">{{ person.name }}</h3>
                            <span class="flex-shrink-0 px-2 py-0.5 bg-theme-accent/15 text-theme-accent rounded text-[10px] font-bold uppercase tracking-wider">Secretary</span>
                        </div>
                        <p class="text-sm text-theme-muted leading-snug">{{ person.affiliation }}</p>
                        {% if person.country %}
                        <div class="text-xs text-theme-muted/70 mt-2.5 flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 opacity-65" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span>{{ person.country }}</span>
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </section>

            <!-- Active Members -->
            <section id="active-members" class="border-t border-theme-text/10 pt-10 scroll-mt-32">
                <h2 class="text-2xl font-bold text-theme-text mb-8">Active Members</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {% for person in members.members %}
                    <div class="bg-theme-surface border border-theme-text/5 rounded-xl p-6 hover:border-theme-accent/30 transition-all shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-3 gap-2">
                                <h3 class="text-base font-bold text-theme-text leading-tight">{{ person.name }}</h3>
                                <span class="flex-shrink-0 px-2 py-0.5 bg-theme-text/5 text-theme-muted rounded text-[9px] font-bold uppercase tracking-wider">Member</span>
                            </div>
                            <p class="text-xs text-theme-muted leading-snug">{{ person.affiliation }}</p>
                            {% if person.country %}
                            <div class="text-[11px] text-theme-muted/70 mt-2 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5 opacity-65 text-theme-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <span>{{ person.country }}</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </section>

            <!-- Past Members -->
            <section id="past-members" class="border-t border-theme-text/10 pt-10 scroll-mt-32">
                <h2 class="text-2xl font-bold text-theme-text mb-8">Past Members</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {% for person in members.past %}
                    <div class="bg-theme-surface border border-theme-text/5 rounded-xl p-6 hover:border-theme-accent/30 transition-all shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-3 gap-2">
                                <h3 class="text-base font-bold text-theme-text leading-tight">{{ person.name }}</h3>
                                <span class="flex-shrink-0 px-2 py-0.5 bg-theme-text/5 text-theme-muted rounded text-[9px] font-bold uppercase tracking-wider">Past Member</span>
                            </div>
                            <p class="text-xs text-theme-muted leading-snug">
                                {% if person.affiliation %}
                                    {{ person.affiliation }}
                                {% else %}
                                    <span class="italic text-opacity-50 text-theme-muted">No Affiliation Registered</span>
                                {% endif %}
                            </p>
                            {% if person.country %}
                            <div class="text-[11px] text-theme-muted/70 mt-2 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5 opacity-65 text-theme-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <span>{{ person.country }}</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </section>
        </div>

    </div>
</div>

<script>
function meetingPlanner() {
    return {
        meetingsList: [],
        euawaMeeting: null,
        amerMeeting: null,
        eaopMeeting: null,
        
        init() {
            this.meetingsList = {{ meetings | dump | safe }};
            const now = new Date();
            
            // Filter future meetings
            const futureMeetings = this.meetingsList.filter(m => new Date(m.utc) >= now);
            
            // Find next meeting for each group
            this.euawaMeeting = futureMeetings.find(m => m.group === 'EUAWA') || null;
            this.amerMeeting = futureMeetings.find(m => m.group === 'AMER') || null;
            this.eaopMeeting = futureMeetings.find(m => m.group === 'EAOP') || null;
        },
        
        formatUTC(utcString) {
            const d = new Date(utcString);
            const options = { 
                weekday: 'short', 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric', 
                hour: '2-digit', 
                minute: '2-digit', 
                timeZone: 'UTC',
                hour12: false
            };
            return d.toLocaleDateString('en-US', options) + ' UTC';
        },
        
        formatLocal(utcString) {
            const d = new Date(utcString);
            const options = { 
                weekday: 'short', 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric', 
                hour: '2-digit', 
                minute: '2-digit',
                hour12: true
            };
            
            const localStr = d.toLocaleDateString(undefined, options);
            
            // Try to extract time zone abbreviation
            let tzAbbr = '';
            try {
                const parts = new Intl.DateTimeFormat(undefined, { timeZoneName: 'short' }).formatToParts(d);
                const tzPart = parts.find(p => p.type === 'timeZoneName');
                if (tzPart) {
                    tzAbbr = ' (' + tzPart.value + ')';
                }
            } catch(e) {}
            
            return localStr + tzAbbr;
        }
    };
}
</script>
