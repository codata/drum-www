---
layout: base.njk
title: DRUM Ambassador Program
permalink: /ambassadors/
---

{% block head_schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "DRUM Ambassador Program",
  "description": "Directory of international scientific unions and stakeholders participating in the CODATA Digital Representation of Units of Measurement (DRUM) Ambassador Program.",
  "mainEntity": {
    "@type": "ItemList",
    "name": "Participating Scientific Unions & Organizations",
    "numberOfItems": {{ ambassadors.members | length }},
    "itemListElement": [
      {% for item in ambassadors.members %}
      {
        "@type": "Organization",
        "name": "{{ item.name | escape }}",
        "alternateName": "{{ item.id | escape }}",
        "url": "{{ item.website }}",
        {% if item.logo %}
        "logo": "{{ item.logo }}",
        {% endif %}
        {% if item.classifier %}
        "knowsAbout": "{{ item.classifier | escape }}",
        {% elif item.domain %}
        "knowsAbout": "{{ item.domain | escape }}",
        {% endif %}
        {% if item.ror %}
        "sameAs": "https://ror.org/{{ item.ror | replace('https://ror.org/', '') }}",
        {% endif %}
      }{{ "," if not loop.last }}
      {% endfor %}
    ]
  }
}
</script>
{% endblock %}

<div class="py-16" x-data="ambassadorDirectory()">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-theme-muted mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-theme-accent transition-colors">Home</a>
            <span class="opacity-40">/</span>
            <span class="text-theme-text font-semibold">Ambassadors</span>
        </nav>

        <!-- Page Header & Action Card -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16 items-center">
            <div class="lg:col-span-8">
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-theme-surface border border-theme-accent/20 text-theme-accent text-xs font-semibold mb-6 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>CODATA Task Group &bull; Scientific Union Outreach</span>
                </div>

                <h1 class="text-4xl font-extrabold tracking-tight text-theme-text sm:text-5xl lg:text-6xl mb-6">
                    {{ site.pages.ambassadors.title | default("DRUM Ambassador Program") }}
                </h1>
                
                <p class="text-lg md:text-xl text-theme-muted leading-relaxed max-w-3xl">
                    {{ site.pages.ambassadors.lead | default("Bridging international scientific unions, metrology institutions, and domain communities to promote digital representation and standardization of units of measurement worldwide.") }}
                </p>

                <!-- Impact Highlights -->
                <div class="mt-8 flex flex-wrap gap-4 sm:gap-6 text-sm">
                    <div class="flex items-center gap-3 px-4 py-2 rounded-lg bg-theme-surface/70 border border-theme-text/5 shadow-sm">
                        <span class="text-2xl font-bold text-theme-text">{{ ambassadors.members | length }}</span>
                        <span class="text-xs text-theme-muted leading-tight">Scientific Unions<br>&amp; Organizations</span>
                    </div>
                    <div class="flex items-center gap-3 px-4 py-2 rounded-lg bg-theme-surface/70 border border-theme-text/5 shadow-sm">
                        <span class="text-2xl font-bold text-theme-text">FAIR</span>
                        <span class="text-xs text-theme-muted leading-tight">Digital Units<br>&amp; Standards</span>
                    </div>
                    <div class="flex items-center gap-3 px-4 py-2 rounded-lg bg-theme-surface/70 border border-theme-text/5 shadow-sm">
                        <span class="text-2xl font-bold text-theme-text">CDIF</span>
                        <span class="text-xs text-theme-muted leading-tight">Cross-Domain<br>Interoperability</span>
                    </div>
                </div>
            </div>

            <!-- Join / Nominate Card -->
            <div class="lg:col-span-4">
                <div class="p-6 sm:p-8 bg-theme-surface rounded-2xl border border-theme-accent/20 shadow-xl relative overflow-hidden group">
                    <div class="absolute -right-8 -top-8 w-32 h-32 bg-theme-accent/10 rounded-full blur-3xl group-hover:bg-theme-accent/20 transition-colors pointer-events-none"></div>
                    
                    <h2 class="text-xl font-bold text-theme-text mb-2 relative z-10">
                        {{ site.pages.ambassadors.join.title | default("Join the Program") }}
                    </h2>
                    <p class="text-sm text-theme-muted mb-6 relative z-10 leading-relaxed">
                        {{ site.pages.ambassadors.join.description | default("We welcome representatives from International Scientific Unions, standards bodies, and research organizations to champion FAIR units in their disciplines.") }}
                    </p>
                    
                    <div class="flex flex-col gap-3 relative z-10">
                        <a href="{{ site.pages.ambassadors.join.email }}" class="w-full inline-flex items-center justify-center px-6 py-3 text-sm font-bold rounded-[var(--radius-theme)] text-theme-accent-fg bg-theme-accent hover:bg-theme-accent/90 transition-all shadow-md hover:-translate-y-0.5">
                            {{ site.pages.ambassadors.join.cta | default("Apply or Nominate") }}
                            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        
                        <a href="/membership/" class="w-full inline-flex items-center justify-center px-6 py-2.5 text-sm font-semibold rounded-[var(--radius-theme)] text-theme-text bg-theme-surface/90 hover:bg-theme-surface border border-theme-text/10 transition-all">
                            View Task Group Members
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Program Pillars: Role, Profile, Benefits -->
        <div class="mb-20">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <h2 class="text-3xl font-bold text-theme-text tracking-tight mb-4">Program Framework</h2>
                <p class="text-base text-theme-muted">
                    DRUM Ambassadors act as vital bridges between domain-specific scientific communities and international metrology bodies, ensuring digital units are universally actionable and FAIR.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Ambassador Role -->
                <div class="bg-theme-surface border border-theme-text/10 rounded-2xl p-7 shadow-sm hover:border-theme-accent/30 transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-theme-accent/10 text-theme-accent flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-theme-text mb-2">{{ ambassadors.role.title }}</h3>
                        <p class="text-xs text-theme-muted mb-6 leading-relaxed">{{ ambassadors.role.description }}</p>
                        
                        <ul class="space-y-3.5 text-sm text-theme-muted">
                            {% for item in ambassadors.role.items %}
                            <li class="flex items-start gap-3">
                                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span class="leading-relaxed">{{ item.text | safe }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <!-- Ambassador Profile -->
                <div class="bg-theme-surface border border-theme-text/10 rounded-2xl p-7 shadow-sm hover:border-theme-accent/30 transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-theme-accent/10 text-theme-accent flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-theme-text mb-2">{{ ambassadors.profile.title }}</h3>
                        <p class="text-xs text-theme-muted mb-6 leading-relaxed">{{ ambassadors.profile.description }}</p>
                        
                        <ul class="space-y-3.5 text-sm text-theme-muted">
                            {% for item in ambassadors.profile.items %}
                            <li class="flex items-start gap-3">
                                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span class="leading-relaxed">{{ item.text | safe }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <!-- Key Benefits -->
                <div class="bg-theme-surface border border-theme-text/10 rounded-2xl p-7 shadow-sm hover:border-theme-accent/30 transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-theme-accent/10 text-theme-accent flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-theme-text mb-2">{{ ambassadors.benefits.title }}</h3>
                        <p class="text-xs text-theme-muted mb-6 leading-relaxed">{{ ambassadors.benefits.description }}</p>
                        
                        <ul class="space-y-3.5 text-sm text-theme-muted">
                            {% for item in ambassadors.benefits.items %}
                            <li class="flex items-start gap-3">
                                <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span class="leading-relaxed">{{ item.text | safe }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Directory Header & Controls -->
        <section id="directory" class="border-t border-theme-text/10 pt-16 scroll-mt-28">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
                <div>
                    <h2 class="text-3xl font-bold text-theme-text tracking-tight mb-2">
                        Participating Scientific Unions &amp; Organizations
                    </h2>
                    <p class="text-sm text-theme-muted max-w-2xl">
                        Explore the international unions and bodies engaged in the DRUM Ambassador Program. Search by acronym, union name, or filter by scientific field.
                    </p>
                </div>
                
                <!-- Live Count Badge -->
                <div class="flex-shrink-0">
                    <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-theme-surface border border-theme-text/10 text-theme-text">
                        Showing <span class="text-theme-accent font-bold mx-1" x-text="filteredMembers.length"></span> of {{ ambassadors.members | length }} organizations
                    </span>
                </div>
            </div>

            <!-- Search & Field Filter Bar -->
            <div class="p-4 sm:p-6 bg-theme-surface/70 backdrop-blur-md rounded-2xl border border-theme-text/10 mb-10 shadow-sm space-y-4">
                <div class="flex flex-col md:flex-row gap-4 items-stretch md:items-center justify-between">
                    <!-- Search Input -->
                    <div class="relative flex-grow">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-theme-muted">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                        <input type="text"
                               x-model="searchQuery"
                               placeholder="Search by acronym (e.g., IUPAC, IUCr, IAU), name, or keyword..."
                               class="w-full pl-10 pr-10 py-2.5 text-sm rounded-xl bg-theme-surface border border-theme-text/15 text-theme-text placeholder-theme-muted/60 focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent transition-all shadow-inner">
                        <button x-show="searchQuery" 
                                @click="searchQuery = ''" 
                                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-theme-muted hover:text-theme-text transition-colors cursor-pointer"
                                title="Clear search">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>

                    <!-- Filter by UNESCO Classifier / Field Dropdown -->
                    <div class="flex-shrink-0 md:w-72">
                        <div class="relative">
                            <select x-model="selectedClassifier"
                                    class="w-full pl-3.5 pr-9 py-2.5 text-sm rounded-xl bg-theme-surface border border-theme-text/15 text-theme-text font-medium focus:outline-none focus:ring-2 focus:ring-theme-accent focus:border-transparent transition-all shadow-inner appearance-none cursor-pointer">
                                <option value="">All Scientific Fields</option>
                                <template x-for="c in classifiers" :key="c">
                                    <option :value="c" x-text="c"></option>
                                </template>
                            </select>
                            <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-theme-muted">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Active Filter Tags (visible when filter or search is applied) -->
                <div x-show="selectedClassifier || searchQuery" class="flex flex-wrap items-center gap-2 pt-2 border-t border-theme-text/5 text-xs">
                    <span class="text-theme-muted font-medium">Active filters:</span>
                    <template x-if="selectedClassifier">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-theme-accent/10 border border-theme-accent/20 text-theme-accent font-semibold">
                            <span>Field: <strong x-text="selectedClassifier"></strong></span>
                            <button @click="selectedClassifier = ''" class="hover:text-red-500 cursor-pointer ml-1" title="Clear field filter">&times;</button>
                        </span>
                    </template>
                    <template x-if="searchQuery">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-theme-accent/10 border border-theme-accent/20 text-theme-accent font-semibold">
                            <span>Query: "<strong x-text="searchQuery"></strong>"</span>
                            <button @click="searchQuery = ''" class="hover:text-red-500 cursor-pointer ml-1" title="Clear search query">&times;</button>
                        </span>
                    </template>
                    <button @click="resetFilters()" class="text-theme-muted hover:text-theme-accent underline underline-offset-2 ml-1 cursor-pointer">
                        Clear all
                    </button>
                </div>
            </div>

            <!-- Organization Card Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <template x-for="member in filteredMembers" :key="member.id">
                    <div class="bg-theme-surface border border-theme-text/10 rounded-2xl p-6 hover:border-theme-accent/40 transition-all duration-300 shadow-sm flex flex-col justify-between group relative overflow-hidden">
                        
                        <!-- Top Accent Glow -->
                        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-theme-accent/40 via-theme-accent/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        
                        <div>
                            <!-- Header Row: Acronym, Logo & Domain -->
                            <div class="flex items-center justify-between gap-3 mb-4">
                                <div class="flex items-center gap-2.5">
                                    <!-- Logo Option (displayed if populated) -->
                                    <template x-if="member.logo">
                                        <div class="h-9 w-9 p-1 rounded-lg bg-white/95 dark:bg-slate-900/90 border border-theme-text/10 shadow-xs flex items-center justify-center shrink-0 overflow-hidden">
                                            <img :src="member.logo" :alt="member.name + ' logo'" class="max-h-full max-w-full object-contain">
                                        </div>
                                    </template>
                                    
                                    <span class="px-3 py-1 bg-theme-accent/10 border border-theme-accent/20 text-theme-accent rounded-lg text-sm font-extrabold tracking-wide uppercase font-mono shadow-sm" x-text="member.id"></span>
                                </div>
                                
                                <template x-if="member.classifier || member.domain">
                                    <button @click="selectedClassifier = (member.classifier || member.domain)"
                                            class="text-[11px] font-semibold tracking-wide px-2.5 py-1 rounded-full bg-theme-text/5 hover:bg-theme-accent/15 text-theme-muted hover:text-theme-accent border border-theme-text/10 hover:border-theme-accent/30 text-right leading-tight max-w-[60%] transition-colors cursor-pointer"
                                            :title="'Filter by ' + (member.classifier || member.domain)"
                                            x-text="member.classifier || member.domain"></button>
                                </template>
                            </div>

                            <!-- Organization Full Name -->
                            <h3 class="text-lg font-bold text-theme-text leading-snug mb-4 group-hover:text-theme-accent transition-colors" x-text="member.name"></h3>

                            <!-- Badges / Metadata Links -->
                            <div class="flex flex-wrap items-center gap-2 mb-2">
                                <!-- Official Website Link -->
                                <template x-if="member.website">
                                    <a :href="member.website" 
                                       target="_blank" 
                                       rel="noopener noreferrer"
                                       class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-theme-text/5 hover:bg-theme-accent/15 text-theme-text hover:text-theme-accent transition-all border border-theme-text/10 hover:border-theme-accent/30"
                                       title="Visit Official Homepage">
                                        <svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                        <span>Website</span>
                                    </a>
                                </template>

                                <!-- ROR Identifier Link (High-contrast emerald for both light and dark themes) -->
                                <template x-if="member.ror">
                                    <a :href="'https://ror.org/' + member.ror.replace('https://ror.org/', '')" 
                                       target="_blank" 
                                       rel="noopener noreferrer"
                                       class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-semibold bg-emerald-100 text-emerald-900 border border-emerald-300 hover:border-emerald-500 dark:bg-emerald-950/50 dark:text-emerald-300 dark:border-emerald-500/30 dark:hover:border-emerald-400 transition-all shadow-xs"
                                       title="View Research Organization Registry (ROR) Record">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-700 dark:bg-emerald-400"></span>
                                        <span x-text="'ror:' + member.ror.replace('https://ror.org/', '')"></span>
                                    </a>
                                </template>
                            </div>
                        </div>

                        <!-- Representative (Only shown when populated) -->
                        <template x-if="member.representative && member.representative.name">
                            <div class="mt-4 pt-4 border-t border-theme-text/10">
                                <div class="text-[10px] uppercase font-bold text-theme-muted tracking-wider mb-1">Ambassador</div>
                                <div class="text-sm font-semibold text-theme-text" x-text="member.representative.name"></div>
                                <template x-if="member.representative.role">
                                    <div class="text-xs text-theme-muted" x-text="member.representative.role"></div>
                                </template>
                            </div>
                        </template>

                    </div>
                </template>
            </div>

            <!-- Empty Search State -->
            <div x-show="filteredMembers.length === 0" class="py-16 text-center">
                <div class="w-16 h-16 rounded-full bg-theme-surface border border-theme-text/10 flex items-center justify-center mx-auto mb-4 text-theme-muted">
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-theme-text mb-1">No organizations found</h3>
                <p class="text-sm text-theme-muted mb-6">No organizations match your current search or field filter.</p>
                <button @click="resetFilters()" class="px-5 py-2 text-xs font-bold rounded-lg text-theme-accent-fg bg-theme-accent hover:bg-theme-accent/90 transition-all cursor-pointer">
                    Reset Filters
                </button>
            </div>
        </section>

        <!-- Open to Other Stakeholders Callout -->
        <div class="mt-20 p-8 sm:p-10 rounded-2xl bg-gradient-to-br from-theme-surface via-theme-surface/90 to-theme-surface/50 border border-theme-accent/20 shadow-lg relative overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-8">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-theme-accent/10 text-theme-accent border border-theme-accent/20 mb-4">
                        Expanding Collaboration
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-bold text-theme-text mb-3">
                        Represent Another Scientific Body or Research Institution?
                    </h3>
                    <p class="text-base text-theme-muted leading-relaxed">
                        While the DRUM Ambassador Program initially prioritizes International Scientific Unions, participation is warmly open to other research organizations, metrology institutes, standards development organizations (SDOs), and academic stakeholders committed to digital unit representation.
                    </p>
                </div>
                <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4">
                    <a href="mailto:drum@codata.org?subject=DRUM%20Ambassador%20Inquiry%20-%20External%20Stakeholder"
                       class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold rounded-[var(--radius-theme)] text-theme-accent-fg bg-theme-accent hover:bg-theme-accent/90 transition-all shadow-md text-center">
                        Contact Task Group
                    </a>
                    <a href="https://codata.github.io/drum-book/" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-[var(--radius-theme)] text-theme-text bg-theme-surface hover:bg-theme-surface/80 border border-theme-text/10 transition-all text-center">
                        Read the DRUM Book &rarr;
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
function ambassadorDirectory() {
    const rawMembers = {{ ambassadors.members | dump | safe }};
    
    return {
        searchQuery: '',
        selectedClassifier: '',
        members: rawMembers,
        
        get classifiers() {
            const list = this.members
                .map(m => m.classifier || m.domain)
                .filter(Boolean);
            return [...new Set(list)].sort();
        },
        
        resetFilters() {
            this.searchQuery = '';
            this.selectedClassifier = '';
        },
        
        get filteredMembers() {
            let list = this.members;
            
            // Classifier / field filter
            if (this.selectedClassifier) {
                list = list.filter(m => (m.classifier || m.domain) === this.selectedClassifier);
            }
            
            // Search query filter (matches ID/acronym, Name, Classifier, Domain, Tag, or ROR ID)
            if (this.searchQuery.trim() !== '') {
                const q = this.searchQuery.toLowerCase().trim();
                list = list.filter(m => 
                    (m.id && m.id.toLowerCase().includes(q)) ||
                    (m.name && m.name.toLowerCase().includes(q)) ||
                    (m.classifier && m.classifier.toLowerCase().includes(q)) ||
                    (m.domain && m.domain.toLowerCase().includes(q)) ||
                    (m.tag && Array.isArray(m.tag) && m.tag.some(t => t.toLowerCase().includes(q))) ||
                    (m.ror && m.ror.toLowerCase().includes(q))
                );
            }
            
            return list;
        }
    };
}
</script>
