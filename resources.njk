---
layout: base.njk
title: Tools & Resources
permalink: /resources/
---

{% block head_schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "DRUM Tools & Resources Registry",
  "description": "A curated registry of digital tools, databases, service frameworks, and publications designed to support the digital representation of units of measurement for human and machine systems.",
  "itemListElement": [
    {% for tool in resources %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "item": {
        "@type": "CreativeWork",
        "name": "{{ tool.name | escape }}",
        "description": "{{ tool.description | escape }}",
        "url": "{{ tool.link }}",
        "license": "{{ tool.license | escape }}"
      }
    }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
</script>
{% endblock %}

<div class="py-24 bg-theme-bg">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="max-w-3xl mb-16">
            <h1 class="text-4xl font-bold tracking-tight text-theme-text sm:text-5xl mb-6">{{ site.pages.resources.title }}</h1>
            <p class="text-xl text-theme-muted leading-relaxed">
                {{ site.pages.resources.lead }}
            </p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for tool in resources %}
            <div class="flex flex-col bg-theme-surface/50 border border-theme-text/5 rounded-xl p-8 hover:border-theme-accent/30 transition-all duration-300 group shadow-sm hover:shadow-xl scroll-mt-32">
                <!-- Tool Header -->
                <div class="flex items-center gap-4 mb-6">
                    <div class="flex-shrink-0 w-16 h-16 bg-white/10 rounded-xl overflow-hidden shadow-inner flex items-center justify-center p-2 group-hover:bg-white/20 transition-all duration-500">
                        {% if tool.logo %}
                        <img src="{{ tool.logo }}" alt="{{ tool.name }} Logo" class="max-w-full max-h-full object-contain filter group-hover:scale-110 transition-transform duration-500">
                        {% else %}
                        <div class="w-full h-full flex items-center justify-center text-theme-accent opacity-40 group-hover:opacity-100 transition-opacity">
                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        {% endif %}
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-theme-text group-hover:text-theme-accent transition-colors leading-tight mb-1">{{ tool.name }}</h2>
                        <span class="inline-block px-2 py-0.5 bg-theme-text/5 rounded text-[10px] font-bold text-theme-muted uppercase tracking-wider">{{ tool.license }}</span>
                    </div>
                </div>

                <!-- Description -->
                <p class="text-sm text-theme-muted mb-8 leading-relaxed flex-grow italic">
                    {{ tool.description }}
                </p>

                <!-- Actions -->
                <div class="mt-auto pt-6 border-t border-theme-text/5 flex items-center justify-between">
                    <a href="{{ tool.link }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm font-semibold text-theme-accent hover:underline decoration-2 underline-offset-4">
                        Access Resource
                        <svg class="ml-1 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>

        <!-- Book Companion Callout -->
        <div class="mt-20 p-8 md:p-12 bg-theme-surface rounded-xl border border-theme-accent/20 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-64 h-64 bg-theme-accent/5 rounded-full blur-3xl -mr-32 -mt-32 transition-transform duration-700 group-hover:scale-150"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="max-w-2xl text-center md:text-left">
                    <h2 class="text-2xl md:text-3xl font-bold text-theme-text mb-4">Want to read the full guide?</h2>
                    <p class="text-theme-muted leading-relaxed">
                        The draft DRUM book contains extensive details on standard methodologies and implementation rules.
                    </p>
                </div>
                <a href="https://stuchalk.github.io/CODATA-DRUM/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 bg-theme-accent text-theme-accent-fg font-bold rounded-[var(--radius-theme)] shadow-lg hover:shadow-theme-accent/30 hover:-translate-y-1 transition-all">
                    Read the Companion Book
                    <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>
